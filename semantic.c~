#include "node.h"
#include "symbol.h"
#include <stdio.h>

// 全局变量，指向当前的作用域
SymbolTable *currentScope = NULL;

void
enterScope ()
{
  SymbolTable *newScope = createSymbolTable ();
  if (newScope == NULL)
    {
      printf ("错误：创建新符号表失败。\n");
      return;
    }

  newScope->parent = currentScope;
  currentScope = newScope;
}

void
exitScope ()
{
  if (currentScope)
    {
      SymbolTable *parentScope = currentScope->parent;
      destroySymbolTable (currentScope);
      currentScope = parentScope;
    }
  else
    {
      printf ("警告：尝试退出时，currentScope 为 NULL。\n");
    }
}

void
checkDeclaration (pNode node)
{
  // 检查节点和子节点是否有效
  if (node == NULL || node->child == NULL || node->child->val == NULL)
    {
      printf ("错误：checkDeclaration 中的节点无效\n");
      return;
    }

  // 调试输出，检查当前声明的变量
  printf ("正在检查声明的变量：%s\n", node->child->val);

  // 如果符号表中没有该变量，则添加它
  if (findSymbol (currentScope, node->child->val) == NULL)
    {
      addSymbol (currentScope, node->child->val, TYPE_INT);
    }
  else
    {
      printf ("错误：变量 '%s' 已在第 %d 行声明\n",
	      node->child->val, node->lineNo);
    }
}

void
checkAssignment (pNode node)
{
  // 检查节点和子节点是否有效
  if (node == NULL || node->child == NULL || node->child->val == NULL)
    {
      printf ("错误：checkAssignment 中的节点无效\n");
      return;
    }

  // 调试输出，检查当前赋值的变量
  printf ("正在检查赋值的变量：%s\n", node->child->val);

  // 如果符号表中没有该变量，说明该变量未声明
  if (findSymbol (currentScope, node->child->val) == NULL)
    {
      printf ("错误：变量 '%s' 未在第 %d 行声明\n",
	      node->child->val, node->lineNo);
    }
}

void
performSemanticAnalysis (pNode root)
{
  // 如果节点为空，直接返回
  if (root == NULL)
    {
      return;
    }

  // 调试输出，检查当前分析的节点类型和行号
  printf ("正在进行语义分析，节点类型：%d，所在行：%d\n",
	  root->type, root->lineNo);

  switch (root->type)
    {
    case NODE_DECLARATION:
      checkDeclaration (root);
      break;
    case NODE_ASSIGNMENT:
      checkAssignment (root);
      break;
    case NODE_EXPRESSION:
      // 表达式的语义分析（目前未实现）
      break;
    default:
      //printf ("语义分析：未知的节点类型，行号：%d\n", root->lineNo);
      break;
    }

  // 递归分析子节点和下一个节点
  performSemanticAnalysis (root->child);
  performSemanticAnalysis (root->next);
}

																										   // 修改后的 findSymbol，加入了空指针检查
Symbol *
findSymbol (SymbolTable * table, char *name)
{
  // 检查符号表和名称是否为 NULL
  if (table == NULL || name == NULL)
    {
      printf ("错误：传递给 findSymbol 的指针为 NULL\n");
      return NULL;
    }

  // 计算哈希值，找到对应的符号链表
  unsigned idx = hash (name);
  Symbol *symbol = table->symbols[idx];
  while (symbol)
    {
      if (strcmp (symbol->name, name) == 0)
	{
	  return symbol;
	}
      symbol = symbol->next;
    }
  return NULL;
}
